# =============================================================================
# Drop — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA faça commit de valores reais. Em produção, cadastre na Vercel.
# =============================================================================

# development | staging (homologação) | production
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Banco (Supabase → Project Settings → Database → Connection string) ------
# Use a URL do pooler em modo "Transaction" (porta 6543) para a aplicação.
DATABASE_URL=
# require (Supabase) | disable (Postgres local)
DATABASE_SSL=require

# --- Supabase Auth/Storage (Project Settings → API) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Usada para upload de imagens e gestão de usuários.
SUPABASE_SERVICE_ROLE_KEY=

# --- Segurança ------------------------------------------------------------------
# 32 bytes em base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Segredo dos endpoints /api/cron/* : openssl rand -hex 32
CRON_SECRET=

# --- Mercado Pago (https://www.mercadopago.com.br/developers/panel/app) -------
# Em homologação use as credenciais de TESTE da sua aplicação.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Painel da aplicação → Webhooks → "Assinatura secreta"
MERCADOPAGO_WEBHOOK_SECRET=

# --- Melhor Envio (https://melhorenvio.com.br/painel/gerenciar/tokens) --------
MELHORENVIO_TOKEN=
# sandbox | production
MELHORENVIO_ENV=sandbox
# Obrigatório pela API: "NomeDaAplicacao (email-tecnico@dominio.com)"
MELHORENVIO_USER_AGENT=

# --- CJdropshipping (https://developers.cjdropshipping.com) -------------------
CJ_API_KEY=

# --- E-mail transacional (Resend: https://resend.com) -------------------------
RESEND_API_KEY=
# Ex.: "Minha Loja <pedidos@seudominio.com.br>" (domínio verificado no Resend)
EMAIL_FROM=
